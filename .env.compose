
###> docker/nginx ###
NGINX_IMAGE=nginx:1.29-alpine
NGINX_CONTAINER_NAME=bookit-nginx-dev
NGINX_PORT=8080
###< docker/nginx ###

###> docker/php ###
PHP_SERVICE_NAME=php
PHP_IMAGE=nicolas/bookit:dev
PHP_CONTAINER_NAME=bookit-php-dev
PHP_BUILD_TARGET=dev
PHP_CONSUMER_COMMANDS_NAME=bookit-consumer-commands-dev
###< docker/php ###

###> docker/database ###
DB_IMAGE=postgres:16.13-alpine3.23
DB_CONTAINER_NAME=bookit-database-dev
DB_PORT=15432
POSTGRES_DB=bookit
POSTGRES_PASSWORD=admin
POSTGRES_USER=admin
###< docker/database ###

###> docker/rabbitmq ###
RABBITMQ_IMAGE=rabbitmq:4.2.4-management-alpine
RABBITMQ_CONTAINER_NAME=bookit-rabbitmq-dev
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin
###< docker/rabbitmq ###

###> docker ###
NETWORK_NAME=bookit-nw
###< docker ###
MAILER_IMAGE=axllent/mailpit
MAILER_CONTAINER_NAME=bookit-mailer-dev
